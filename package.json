{
  "name": "radian-harness",
  "version": "1.1.0",
  "private": true,
  "description": "A Pi extension that coordinates Claude Code, Codex, and Pi workers in Herdr panes and git worktrees.",
  "license": "MIT",
  "author": "Cenron",
  "keywords": [
    "pi-package",
    "agentic-engineering",
    "multi-agent-harness"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "files": [
    "README.md",
    "LICENSE",
    "install.sh",
    "config/",
    "roles/",
    "src/",
    "extensions/",
    "skills/"
  ],
  "imports": {
    "#core/*": "./src/core/*",
    "#io/*": "./src/io/*",
    "#pi/*": "./src/pi/*",
    "#workers/*": "./src/workers/*"
  },
  "pi": {
    "extensions": [
      "./extensions/radian.ts"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": []
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"tests/unit/**/*.test.ts\"",
    "test:integration": "node --test --test-concurrency=1 \"tests/integration/**/*.test.ts\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "workspace": "node src/install/cli.ts",
    "publication-check": "node scripts/publication-check.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.0.4",
    "@earendil-works/pi-coding-agent": "1.0.2",
    "@earendil-works/pi-tui": "1.0.2",
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.9",
    "typebox": "1.3.36",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  }
}
